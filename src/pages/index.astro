---
// src/pages/index.astro
import logoFh from '../assets/logo_fh.png';
import imgHome from '../assets/img_home.jpg';
import cruzRoja from '../assets/cruz_roja.png';
import cruzBlanca from '../assets/cruz_blanca.png';
import horarioReloj from '../assets/horario_reloj.png';
import preciosCalculadora from '../assets/precios_calculadora.png';
import avatar1 from '../assets/avatar_1.png';
import aliadoCdh from '../assets/aliado_cdh.png';
import aliadoNovosalud from '../assets/aliado_novosalud.png';
import aliadoVenequip from '../assets/aliado_venequip.png';
import aliadoMercadeus from '../assets/aliado_mercadeus.png';

import servicios1 from '../assets/servicios_1.jpg';
import servicios2 from '../assets/servicios_2.jpg';
import servicios3 from '../assets/servicios_3.jpg';
import servicios4 from '../assets/servicios_4.jpg';
import servicios5 from '../assets/servicios_5.jpg';
import servicios6 from '../assets/servicios_6.jpg';
import servicios7 from '../assets/servicios_7.jpg';
import servicios8 from '../assets/servicios_8.jpg';
import servicios9 from '../assets/servicios_9.jpg';
import servicios10 from '../assets/servicios_10.jpg';
import botonRed from '../assets/boton_red.png';
import botonWhite from '../assets/boton_white.png';
import botonBlue from '../assets/boton_blue.png';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fundación Higea | Nuestra misión es la vida</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- HEADER / NAVBAR (BLOQUE 1) -->
    <header class="navbar">
      <div class="container nav-container">
        <a href="/" class="logo-link" aria-label="Fundación Higea Home">
          <img src={logoFh.src} alt="Fundación Higea Logo" class="logo-img" />
        </a>
        <nav class="nav-links">
          <div class="nav-item has-megamenu">
            <a href="#nosotros">NOSOTROS</a>
            <div class="megamenu">
              <div class="megamenu-left" style="width: 250px !important;">
                <span class="megamenu-title">NOSOTROS</span>
              </div>
              <div class="megamenu-right">
                <a href="#quienes-somos">QUIÉNES SOMOS</a>
                <a href="#mision">MISIÓN Y VISIÓN</a>
                <a href="#historia">HISTORIA</a>
                <a href="#valores">VALORES FUNDAMENTALES</a>
                <a href="#objetivos">OBJETIVOS</a>
                <a href="#equipo">EQUIPO Y LIDERAZGO</a>
                <a href="#impacto">IMPACTO</a>
              </div>
            </div>
          </div>
          <div class="nav-item has-megamenu">
            <a href="#servicios">SERVICIOS</a>
            <div class="megamenu">
              <div class="megamenu-left" style="width: 250px !important;">
                <span class="megamenu-title">SERVICIOS</span>
              </div>
              <div class="megamenu-right">
                <a href="#diagnostico">DIAGNÓSTICO POR IMÁGENES</a>
                <a href="#tratamientos">SALA DE TRATAMIENTOS</a>
                <a href="#especiales">ESTUDIOS ESPECIALES</a>
                <a href="#farmacia">FARMACIA</a>
                <a href="#laboratorio">LABORATORIO</a>
                <a href="#consultas">CONSULTAS MÉDICAS</a>
              </div>
            </div>
          </div>
          <div class="nav-item has-megamenu">
            <a href="#programas">PROGRAMAS</a>
            <div class="megamenu">
              <div class="megamenu-left" style="width: 250px !important;">
                <span class="megamenu-title">PROGRAMAS</span>
              </div>
              <div class="megamenu-right">
                <a href="#proyecto-grata">PROYECTO GRATA</a>
                <a href="#oportunidad-higea">OPORTUNIDAD HIGEA</a>
                <a href="#amigos-voluntariado">AMIGOS DEL VOLUNTARIADO</a>
              </div>
            </div>
          </div>
          <div class="nav-item">
            <a href="#voluntariado">VOLUNTARIADO</a>
          </div>
          <div class="nav-item">
            <a href="#actualidad">ACTUALIDAD</a>
          </div>
          <div class="nav-item">
            <a href="#red-higea">RED HIGEA</a>
          </div>
          <div class="nav-item">
            <a href="#para-pacientes">PARA PACIENTES</a>
          </div>
        </nav>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hero" style={`background-image: url('${imgHome.src}')`}>
      <div class="hero-overlay"></div>
      <div class="hero-content container">
        <h1>NUESTRA MISIÓN ES LA VIDA</h1>
        <div style="margin-top: -25px !important;"class="hero-badge"> 
          <span>+50 años al servicio de quien más lo necesita</span>
        </div>
        <div class="hero-buttons" >
          <a href="#cotizar" class="btn-hero-white" style={`background-image: url('${botonWhite.src}') ; height: 39px !important; padding-top: 6px !important;` } >COTIZAR</a>
          <a href="#donar" class="btn-hero-red" style={`background-image: url('${botonRed.src}') ; height: 39px !important; padding-top: 6px !important;`}>DONAR</a>
        </div>
      </div>
    </section>

    <!-- ¿CÓMO PODEMOS SERVIRTE HOY? -->
    <section class="section category-section">
      <div class="container text-center">
        <h2 class="section-title">¿CÓMO PODEMOS SERVIRTE HOY?</h2>
        <div class="category-grid">
          <div class="category-card card-medicos">
            <div class="card-bg" style={`background-image: url('${servicios1.src}')`}></div>
            <div class="card-content">
              <img src={cruzRoja.src} class="red-cross" alt="Cruz" />
              <span class="card-title">SERVICIOS<br />MÉDICOS</span>
            </div>
          </div>
          <div class="category-card card-programas">
            <div class="card-bg" style={`background-image: url('${servicios2.src}')`}></div>
            <div class="card-content">
              <img src={cruzRoja.src} class="red-cross" alt="Cruz" />
              <span class="card-title">PROGRAMAS</span>
            </div>
          </div>
          <div class="category-card card-ayuda">
            <div class="card-bg" style={`background-image: url('${servicios3.src}')`}></div>
            <div class="card-content">
              <img src={cruzRoja.src} class="red-cross" alt="Cruz" />
              <span class="card-title">RECIBIR<br />AYUDA</span>
            </div>
          </div>
          <div class="category-card card-actualidad">
            <div class="card-bg" style={`background-image: url('${servicios4.src}')`}></div>
            <div class="card-content">
              <img src={cruzRoja.src} class="red-cross" alt="Cruz" />
              <span class="card-title">ACTUALIDAD</span>
            </div>
          </div>
        </div>
        <div class="divider"></div>
      </div>
    </section>

    <!-- METRICS SECTION -->
    <section class="section metrics-section">
      <div class="container">
        <div class="metrics-grid">
          <div class="metric-item">
            <div class="metric-number">
              <img src={cruzRoja.src} class="plus" alt="Cruz" />900
            </div>
            <p class="metric-label" >Pacientes adultos<br />atendidos en 2025</p>
          </div>
          <div class="metric-item">
            <div class="metric-number">
              <img src={cruzRoja.src} class="plus" alt="Cruz" />200
            </div>
            <p class="metric-label">Pacientes infantiles<br />atendidos en 2025</p>
          </div>
          <div class="metric-item">
            <div class="metric-number">
              <img src={cruzRoja.src} class="plus" alt="Cruz" />500
            </div>
            <p class="metric-label">Ayudas brindadas<br />por el Voluntariado</p>
          </div>
        </div>
      </div>
    </section>
    
    <div class="container">
      <div class="divider margin-top-lg"></div>
    </div>

    <!-- SERVICES GRID SECTION -->
    <section class="section services-section">
      <div class="container">
        <div class="services-grid">
          <!-- Card 1 -->
          <div class="service-card">
            <div class="service-img img-diagnostico" style={`background-image: url('${servicios5.src}')`}></div>
            <div class="service-body">
              <img src={cruzRoja.src} class="service-cross" alt="Cruz" />
              <h3>DIAGNÓSTICO POR<br />IMÁGENES</h3>
            </div>
          </div>
          <!-- Card 2 -->
          <div class="service-card">
            <div class="service-img img-tratamientos" style={`background-image: url('${servicios6.src}')`}></div>
            <div class="service-body">
              <img src={cruzRoja.src} class="service-cross" alt="Cruz" />
              <h3>SALA DE<br />TRATAMIENTOS</h3>
            </div>
          </div>
          <!-- Card 3 -->
          <div class="service-card">
            <div class="service-img img-especiales" style={`background-image: url('${servicios7.src}')`}></div>
            <div class="service-body">
              <img src={cruzRoja.src} class="service-cross" alt="Cruz" />
              <h3>ESTUDIOS<br />ESPECIALES</h3>
            </div>
          </div>
          <!-- Card 4 -->
          <div class="service-card">
            <div class="service-img img-farmacia" style={`background-image: url('${servicios8.src}')`}></div>
            <div class="service-body">
              <img src={cruzRoja.src} class="service-cross" alt="Cruz" />
              <h3>FARMACIA</h3>
            </div>
          </div>
          <!-- Card 5 -->
          <div class="service-card">
            <div class="service-img img-laboratorio" style={`background-image: url('${servicios9.src}')`}></div>
            <div class="service-body">
              <img src={cruzRoja.src} class="service-cross" alt="Cruz" />
              <h3>LABORATORIO</h3>
            </div>
          </div>
          <!-- Card 6 -->
          <div class="service-card">
            <div class="service-img img-consultas" style={`background-image: url('${servicios10.src}')`}></div>
            <div class="service-body">
              <img src={cruzRoja.src} class="service-cross" alt="Cruz" />
              <h3>CONSULTAS<br />MÉDICAS</h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INFORMACIÓN Y PRECIOS SECTION -->
    <section class="section info-section">
      <div class="container text-center">
        <h2 class="section-title">INFORMACIÓN Y PRECIOS</h2>
        <div class="info-grid">
          <!-- Left Column -->
          <div class="info-box-col">
            <div class="info-box-top">
              <div class="info-icon">
                <img src={horarioReloj.src} alt="Horario de atención" class="info-icon-img" />
              </div>
              <div class="info-content">
                <h3>HORARIO<br />DE ATENCIÓN</h3>
                <p class="schedule">
                  Lunes a Viernes<br />
                  <strong>8:00 A.M. <span class="red-plus">+</span> 6:00 P.M.</strong><br />
                  Sábados<br />
                  <strong>8:00 A.M. <span class="red-plus">+</span> 1:00 P.M.</strong>
                </p>
              </div>
            </div>
            <div class="info-actions">
              <a href="#ubicacion" class="btn-img-blue" style={`background-image: url('${botonBlue.src}')`}>UBICACIÓN</a>
              <a href="#contactos" class="btn-img-blue" style={`background-image: url('${botonBlue.src}')`}>CONTACTOS</a>
            </div>
          </div>

          <!-- Right Column -->
          <div class="info-box-col">
            <div class="info-box-top">
              <div class="info-icon">
                <img src={preciosCalculadora.src} alt="Calculadora de precios" class="info-icon-img" style="width: 90px !important; height: 90px !important;" />
              </div>
              <div class="info-content">
                <h3>CALCULADORA</h3>
                <p class="calc-desc">
                  Cotiza tus exámenes<br />
                  y estudios médicos<br />
                  de forma rápida.
                </p>
              </div>
            </div>
            <div class="info-actions">
              <a href="#precios" class="btn-img-blue" style={`background-image: url('${botonBlue.src}')`}>PRECIOS</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VOCES DE ESPERANZA SECTION -->
    <section class="section testimonials-section">
      <div class="container text-center">
        <h2 class="section-title">VOCES DE ESPERANZA</h2>
        <!-- ========================================== -->
        <!-- AQUÍ PEGAS EL WIDGET DE TRUSTINDEX/ELFSIGHT -->
        <script defer async src='https://cdn.trustindex.io/loader.js?b9940a7811d55340ab0686d7cd9'></script>

        <!-- SPONSOR LOGOS -->
        <div class="divider margin-top-lg"></div>
        <div class="partners-row">
          <img src={aliadoCdh.src} alt="CDH - Centro Diagnóstico Higea" class="partner-img" />
          <img src={aliadoNovosalud.src} alt="Novosalud" class="partner-img" />
          <img src={aliadoVenequip.src} alt="Venequip" class="partner-img" />
          <img src={aliadoMercadeus.src} alt="Mercadeus" class="partner-img" />
        </div>
      </div>
    </section>

    <!-- NEWSLETTER FOOTER -->
    <footer class="newsletter-footer">
      <div class="container text-center">
        <h2>SUSCRÍBETE A NUESTRO NEWSLETTER</h2>
        <p class="subtitle">Recibe noticias, eventos y actualizaciones de la Fundación.</p>
        <form id="newsletterForm" class="newsletter-form">
          <input type="email" id="newsletterEmail" placeholder="Tu correo electrónico" required />
          <button type="submit" class="btn-submit" id="submitBtn">SUSCRIBIRME</button>
        </form>
        
        <p id="newsletterMessage" style="display: none; color: #ffffff; margin-top: 15px; margin-bottom: 40px; font-size: 1.1rem; font-weight: 600;">
          ¡Gracias por suscribirte! Pronto recibirás nuestras novedades.
        </p>

        <script type="module">
          // Importamos las funciones desde el CDN modular de Firebase
          import { initializeApp } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";
          import { getFirestore, collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js";

          // Configuración de tu Firebase
          const firebaseConfig = {
            apiKey: "AIzaSyB4H9LeWn76d1ukfkVPX3bSH0QD4uxqQ9A",
            authDomain: "fundacion-higea-nesletter.firebaseapp.com",
            projectId: "fundacion-higea-nesletter",
            storageBucket: "fundacion-higea-nesletter.firebasestorage.app",
            messagingSenderId: "1044047411086",
            appId: "1:1044047411086:web:6e7100a8097ff1bdefd6df"
          };

          // Inicializamos Firebase y Firestore
          const app = initializeApp(firebaseConfig);
          const db = getFirestore(app);

          // Ruta de colección
          const collectionPath = 'suscriptores';

          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('newsletterForm');
            const message = document.getElementById('newsletterMessage');
            const btnSubmit = document.getElementById('submitBtn');
            const emailInput = document.getElementById('newsletterEmail');
            
            if(form) {
              form.addEventListener('submit', async (e) => {
                e.preventDefault(); // Evita que la página se recargue
                
                const email = emailInput.value;
                const originalText = btnSubmit.textContent;
                
                // 1. Cambiamos el estado del botón a "Cargando"
                btnSubmit.textContent = 'ENVIANDO...';
                btnSubmit.disabled = true;

                try {
                  // 2. Guardamos el correo en la colección 'suscriptores' de Firestore
                  await addDoc(collection(db, collectionPath), {
                    email: email,
                    fecha: serverTimestamp() // Guarda la marca de tiempo exacta
                  });

                  // 3. Ocultamos el formulario y mostramos el mensaje de éxito
                  form.style.display = 'none';
                  message.style.display = 'block';
                  message.style.color = '#ffffff';
                  message.textContent = '¡Gracias por suscribirte! Pronto recibirás nuestras novedades.';

                } catch (error) {
                  console.error("Error al suscribirse: ", error);
                  
                  // 4. Si hay error, restauramos el botón y mostramos un mensaje temporal
                  btnSubmit.textContent = originalText;
                  btnSubmit.disabled = false;
                  
                  message.style.display = 'block';
                  message.style.color = '#ffcccc'; // Rojo claro para error
                  message.textContent = 'Hubo un error al suscribirte. Verifica tu conexión e intenta de nuevo.';
                }
              });
            }
          });
        </script>
      </div>
      <div class="copyright-bar">
        <p>&copy; 2026 | Fundación Higea. Derechos reservados</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* BRAND PALETTE & TYPOGRAPHY SPECIFICATIONS */
  :root {
    --pantone-300c: #005db5; /* Azul: #005db5 */
    --pantone-485c: #c22a22; /* Rojo: #c22a22 */
    --secondary-cyan: #009bdb; /* Cyan: #009bdb */
    --light-gray: #edeef0; /* Gris: #edeef0 */
    --text-dark: #5b5b5f; /* Textos: #5b5b5f */
    
    --primary-blue: var(--pantone-300c);
    --dark-blue: #00468b;
    --accent-red: var(--pantone-485c);
    --accent-cyan: var(--secondary-cyan);
    --font-family: 'Gotham', 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-family);
    color: var(--text-dark);
    background-color: #ffffff;
    line-height: 1.5;
    letter-spacing: 1px;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .text-center {
    text-align: center;
  }

  .section {
    padding: 50px 0;
  }

  .section-title {
    font-size: 1.725rem;
    font-weight: 800;
    color: var(--pantone-300c);
    letter-spacing: 0.5px;
    margin-bottom: 30px;
    text-transform: uppercase;
  }

  .divider {
    height: 3px;
    background-color: var(--primary-blue);
    width: 650px;
    margin: 40px auto 0 auto;
    border-radius: 2px;
  }

  .margin-top-lg {
    margin-top: 50px;
  }

  /* BUTTONS */
  .btn {
    display: inline-block;
    padding: 10px 28px;
    font-size: 1.075rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 30px;
    transition: all 0.2s ease-in-out;
    text-align: center;
    cursor: pointer;
    border: none;
  }

  .btn-white {
    background-color: #ffffff;
    color: var(--primary-blue);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }

  .btn-white:hover {
    background-color: #f8fafc;
    transform: translateY(-2px);
  }

  .btn-red {
    background-color: var(--accent-red);
    color: #ffffff;
    box-shadow: 0 4px 6px rgba(0,0,0,0.15);
  }

  .btn-red:hover {
    background-color: #a3201a;
    transform: translateY(-2px);
  }

  .btn-pill-blue {
    background-color: var(--primary-blue);
    color: #ffffff;
    padding: 6px 20px;
    font-size: 0.925rem;
    border-radius: 20px;
  }

  .btn-pill-blue:hover {
    background-color: var(--dark-blue);
  }

  .btn-rect-blue {
    background-color: var(--primary-blue);
    color: #ffffff;
    padding: 8px 18px;
    font-size: 0.975rem;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.2s;
  }

  .btn-rect-blue:hover {
    background-color: var(--dark-blue);
  }

  /* HEADER / NAVBAR (BLOQUE 1) */
  .navbar {
    background: rgba(242, 247, 253, 0.88);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border-bottom: 1px solid rgba(0, 93, 181, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 10px 0;
    box-shadow: 0 4px 12px rgba(0, 70, 140, 0.05);
  }

  .nav-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-end;
    padding-bottom: 2px;
  }

  .logo-link {
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    padding-bottom: 0px;
  }

  .logo-img {
    height: 70px;
    width: auto;
    object-fit: contain;
    padding-left: 60px;
  }

  .nav-links {
    display: flex;
    align-items: flex-end;
    gap: 0;
    padding-bottom: 0;
    margin-left: 130px;
  }

  .nav-item.has-dropdown {
    position: relative;
  }

  .nav-item.has-megamenu {
    position: relative;
  }

  .nav-item > a {
    display: block;
    text-decoration: none;
    color: var(--pantone-300c);
    font-size: 0.90rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 12px 14px;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .nav-item:hover > a {
    background-color: var(--pantone-300c);
    color: #ffffff;
  }

  .has-megamenu:hover > a {
    background-color: var(--dark-blue);
    color: #ffffff;
  }

  /* Dropdown simple */
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #ffffff;
    min-width: 220px;
    z-index: 200;
    box-shadow: 0 8px 24px rgba(0, 70, 140, 0.15);
    border-top: 3px solid var(--pantone-300c);
  }

  .has-dropdown:hover .dropdown {
    display: block;
  }

  .dropdown a {
    display: block;
    padding: 10px 18px;
    color: var(--pantone-300c);
    font-size: 0.805rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-bottom: 1px solid #edf2f7;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .dropdown a:last-child {
    border-bottom: none;
  }

  .dropdown a:hover {
    background-color: #f0f6ff;
    color: var(--dark-blue);
  }

  /* MEGA MENU — NOSOTROS */
  .megamenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0; /* Aligns EXACTLY with the left edge of the NOSOTROS button */
    margin-top: 12px; /* Push exactly to the bottom limit of navbar (10px navbar padding + 2px nav container padding) */
    z-index: 200;
    flex-direction: row;
